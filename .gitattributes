# 默认：交给 git 自动判断文本/二进制，仓库里统一存 LF
* text=auto eol=lf

# 在 Linux 虚拟机里执行的脚本，必须是 LF，否则会报 "$'\r': command not found"
*.sh   text eol=lf
gradlew text eol=lf

# Windows 专用脚本保持 CRLF
*.bat  text eol=crlf

# 二进制文件不要做换行转换
*.jar  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.zip  binary


# Legacy precompute script is also executed by Linux
precompute.sh1 text eol=lf
